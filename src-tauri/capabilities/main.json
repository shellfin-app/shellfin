{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Least-privilege capability for the main window (§9.1): global event listen/unlisten plus one allow-<command> per app command. No plugin (dialog, opener, notification, updater), fs, shell or window permissions.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-app-frontend-ready",
    "allow-app-quit-ack",
    "allow-app-quit-cancel",
    "allow-app-quit",
    "allow-app-open-logs-dir",
    "allow-app-reveal-path",
    "allow-app-open-external",
    "allow-env-info",
    "allow-agent-status",
    "allow-keys-list",
    "allow-keys-read-public",
    "allow-dialog-pick-identity-file",
    "allow-app-error-report",
    "allow-ssh-config-reload",
    "allow-bookmarks-get",
    "allow-bookmark-save",
    "allow-bookmark-delete",
    "allow-bookmark-copy-from-ssh-config",
    "allow-bookmark-set-password",
    "allow-group-save",
    "allow-group-delete",
    "allow-bookmark-move",
    "allow-group-move",
    "allow-recents-get",
    "allow-recents-clear",
    "allow-bookmarks-export",
    "allow-bookmarks-import-open",
    "allow-bookmarks-import-apply",
    "allow-bookmarks-import-cancel",
    "allow-settings-get",
    "allow-settings-update",
    "allow-settings-reset",
    "allow-notifications-set-texts",
    "allow-session-open",
    "allow-session-answer-prompt",
    "allow-session-reconnect-now",
    "allow-session-disconnect",
    "allow-session-close",
    "allow-session-probe-all",
    "allow-term-open",
    "allow-term-write",
    "allow-term-resize",
    "allow-term-ack",
    "allow-term-restart",
    "allow-term-close",
    "allow-sftp-realpath",
    "allow-sftp-list",
    "allow-sftp-stat",
    "allow-sftp-read-text",
    "allow-sftp-write-text",
    "allow-sftp-create-file",
    "allow-sftp-mkdir",
    "allow-sftp-rename",
    "allow-sftp-delete",
    "allow-transfer-download",
    "allow-transfer-upload-pick",
    "allow-transfer-upload-dropped",
    "allow-transfer-retry",
    "allow-transfer-cancel",
    "allow-window-minimize",
    "allow-window-toggle-maximize",
    "allow-window-toggle-fullscreen",
    "allow-window-close",
    "allow-window-start-dragging",
    "allow-app-save-text-file",
    "allow-menu-set-labels",
    "allow-update-check",
    "allow-update-install",
    "allow-update-cancel",
    "allow-update-skip-version"
  ]
}

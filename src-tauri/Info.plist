<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Merged by Tauri into the generated macOS Info.plist (the CLI picks up an Info.plist next to tauri.conf.json; the
  bundler overwrites its own keys with these). CFBundleLocalizations declares the UI languages the app ships
  (SUPPORTED_LANGUAGES in src/i18n/index.ts, in Apple's identifiers: zh-CN is zh-Hans; checked by
  src/i18n/i18n.test.ts), so macOS can report the user's language to WKWebView (navigator.languages). Whether it does
  is still to be verified on a Mac (ARCHITECTURE §8.2.3).
-->
<plist version="1.0">
<dict>
  <key>CFBundleLocalizations</key>
  <array>
    <string>en</string>
    <string>de</string>
    <string>es</string>
    <string>ja</string>
    <string>uk</string>
  </array>
</dict>
</plist>

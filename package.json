{
  "name": "shellfin",
  "private": true,
  "version": "0.2.0",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shellfin-app/shellfin.git"
  },
  "homepage": "https://shellfin.app",
  "bugs": {
    "url": "https://github.com/shellfin-app/shellfin/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/assert-no-mock.mjs dist",
    "build:smoke": "vite build --mode smoke --outDir dist-smoke --emptyOutDir",
    "test:freeze": "npm run build:smoke && node scripts/freeze-check.mjs dist-smoke",
    "smoke:tauri": "npm run build:smoke && tauri build --debug --no-bundle --config tauri.smoke.conf.json",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "i18n:check": "i18next-cli extract --ci --dry-run && node scripts/menu-mnemonics-check.mjs",
    "i18n:extract": "i18next-cli extract && node scripts/i18n-missing.mjs --prune",
    "i18n:missing": "node scripts/i18n-missing.mjs",
    "i18n:status": "node scripts/i18n-missing.mjs",
    "bindings": "cd src-tauri && cargo test --locked export_bindings",
    "bindings:check": "npm run bindings && node scripts/bindings-check.mjs",
    "notices": "node scripts/notices.mjs",
    "notices:check": "node scripts/notices.mjs --check",
    "rust:check": "cd src-tauri && cargo fmt --check && cargo clippy --locked --all-targets -- -D warnings && cargo test --locked"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@tanstack/react-virtual": "3.14.21",
    "@tauri-apps/api": "2.12.4",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "cmdk": "1.1.1",
    "i18next": "26.5.3",
    "immer": "11.2.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.0",
    "react-resizable-panels": "4.14.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "i18next-cli": "1.77.0",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
